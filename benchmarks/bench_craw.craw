fn craw_time_ms() -> i64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap()
        .as_millis() as i64
}

def fib(n: Int) -> Int:
    if n <= 1:
        return n
    return fib(n - 1) + fib(n - 2)

def primes(n: Int) -> Int:
    sieve = []
    i = 0
    while i <= n:
        sieve.append(True)
        i = i + 1
    
    p = 2
    while p * p <= n:
        if sieve[p]:
            i = p * p
            while i <= n:
                sieve[i] = False
                i = i + p
        p = p + 1
        
    count = 0
    i = 2
    while i <= n:
        if sieve[i]:
            count = count + 1
        i = i + 1
    return count

def matmul(size: Int) -> Int:
    A = []
    B = []
    i = 0
    j = 0
    k = 0
    
    while i < size:
        rowA = []
        rowB = []
        j = 0
        while j < size:
            rowA.append(i + j)
            rowB.append(i - j)
            j = j + 1
        A.append(rowA)
        B.append(rowB)
        i = i + 1
        
    C = []
    i = 0
    while i < size:
        rowC = []
        j = 0
        while j < size:
            rowC.append(0)
            j = j + 1
        C.append(rowC)
        i = i + 1

    i = 0
    while i < size:
        j = 0
        while j < size:
            k = 0
            while k < size:
                C[i][j] = C[i][j] + A[i][k] * B[k][j]
                k = k + 1
            j = j + 1
        i = i + 1
    return C[0][0]

def main():
    # Warmup
    fib(10)
    primes(100)
    matmul(10)
    
    print("--- Craw (Native) Benchmark ---")
    
    start1 = craw_time_ms()
    res1 = fib(30)
    end1 = craw_time_ms()
    print("Fib(30)          = ", res1, " | Time: ", end1 - start1, " ms")

    start2 = craw_time_ms()
    res2 = primes(1000000)
    end2 = craw_time_ms()
    print("Primes(1000000)  = ", res2, " | Time: ", end2 - start2, " ms")

    start3 = craw_time_ms()
    res3 = matmul(200)
    end3 = craw_time_ms()
    print("Matmul(200x200)  = ", res3, " | Time: ", end3 - start3, " ms")

main()
