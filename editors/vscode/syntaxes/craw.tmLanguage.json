{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Craw",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#rust_passthrough"
        },
        {
            "include": "#rust_top_level_braced"
        },
        {
            "include": "#rust_top_level_line"
        },
        {
            "include": "#rust_blocks"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#identifiers"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.craw",
                    "match": "#.*$"
                }
            ]
        },
        "rust_passthrough": {
            "begin": "^\\\\",
            "end": "$",
            "name": "meta.embedded.rust.craw",
            "patterns": [
                {
                    "include": "source.rust"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.craw",
                    "match": "\\b(if|else|return|while|for|in|break|continue|match|case|yield|then|to|until|where|from|import|use|as|global|nonlocal|select|orderby|ascending|descending|not|and|or|is|let|def|fn|gen|data|type|struct|trait|impl|enum|template|macro|class|extends|with|copyclosure|addpattern|operator)\\b"
                },
                {
                    "name": "constant.language.craw",
                    "match": "\\b(true|false|none|True|False|None)\\b"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.craw",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.craw",
                    "match": "\\\\."
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.integer.craw",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.craw",
                    "match": "(\\+|\\-|\\*|/|%|==|!=|>|<|>=|<=|=|\\|>|\\.\\.|\\?\\?|\\->|=>)"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "entity.name.function.craw",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
                },
                {
                    "name": "variable.other.craw",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "rust_top_level_braced": {
            "begin": "^\\s*(?=(fn|struct|enum|trait|impl)\\b)",
            "end": "(?<=\\})",
            "name": "meta.embedded.rust.craw",
            "patterns": [
                {
                    "include": "source.rust"
                }
            ]
        },
        "rust_top_level_line": {
            "begin": "^\\s*(?=(use|type|extern|let)\\b)",
            "end": "$",
            "name": "meta.embedded.rust.craw",
            "patterns": [
                {
                    "include": "source.rust"
                }
            ]
        },
        "rust_blocks": {
            "begin": "^\\s*(rust)\\s*:\\s*$",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.rust-block.craw"
                }
            },
            "end": "^(?=\\S)",
            "name": "meta.embedded.rust.craw",
            "patterns": [
                {
                    "include": "source.rust"
                }
            ]
        }
    },
    "scopeName": "source.craw"
}
