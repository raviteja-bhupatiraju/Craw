{
    "comments": {
        "lineComment": "#"
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string"] },
        { "open": "'", "close": "'", "notIn": ["string", "comment"] },
        { "open": "`", "close": "`", "notIn": ["string", "comment"] }
    ],
    "autoCloseBefore": ";:.,=}])>` \n\t",
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"],
        ["`", "`"]
    ],
    "wordPattern": "(-?\\d+\\.?\\d*)|[A-Za-z_][A-Za-z0-9_]*|[∘≈÷±λ]",
    "indentationRules": {
        "increaseIndentPattern": "^.*(\\{[^}\"']*|\\([^)\"']*|:\\s*)$",
        "decreaseIndentPattern": "^\\s*[\\}\\]\\)]\\s*$"
    },
    "onEnterRules": [
        {
            "beforeText": "^.*:\\s*$",
            "action": { "indentAction": "indent" }
        },
        {
            "beforeText": "^\\s*(return|break|continue|pass)\\b.*$",
            "action": { "indentAction": "outdent" }
        }
    ],
    "folding": {
        "markers": {
            "start": "^\\s*#\\s*region\\b",
            "end": "^\\s*#\\s*endregion\\b"
        }
    }
}
