{
  "name": "craw",
  "displayName": "Craw Language Support",
  "publisher": "local",
  "version": "0.1.0",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/local/craw"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:craw"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "craw",
        "extensions": [
          ".craw"
        ],
        "aliases": [
          "Craw"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/craw.svg",
          "dark": "./icons/craw.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "craw",
        "scopeName": "source.craw",
        "path": "./syntaxes/craw.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "compile": "tsc -p ./"
  }
}
