data Point(x, y)

def test_eq():
    print("Testing eq:")
    print("1 == 1:", 1 == 1)
    print("1.0 == 1.0:", 1.0 == 1.0)
    print("1 == 1.0:", 1 == 1.0)
    print("1.0 == 1:", 1.0 == 1)
    print("1 == 2:", 1 == 2)
    print("1.0 == 2.0:", 1.0 == 2.0)
    print("1 == 2.0:", 1 == 2.0)
    print("1.0 == 2:", 1.0 == 2)

def test_unwrap():
    print("\nTesting unwrap in get_item:")
    i = 1
    def inner():
        nonlocal i
        l = [10, 20, 30]
        # i is Recursive here
        print("l[i]:", l[i])
    inner()

def test_orderby():
    print("\nTesting orderby-like comparisons with mixed types:")
    # Since orderby keyword is not working for builtin call easily, 
    # we test the underlying comparisons.
    l = [2.0, 1, 3.5, 0]
    # Simple manual sort to test lt and eq
    print("1 < 2.0:", 1 < 2.0)
    print("2.0 < 1:", 2.0 < 1)
    print("1 == 1.0:", 1 == 1.0)

def test_data():
    print("\nTesting Data objects and collections:")
    p1 = Point(1, 2.0)
    p2 = Point(1.0, 2)
    print("p1:", p1)
    print("p2:", p2)
    print("list:", [1, 2, 3])
    print("dict:", {"a": 1, "b": 2})

test_eq()
test_unwrap()
test_orderby()
test_data()
